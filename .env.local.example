# ── Supabase ──────────────────────────────────────────────────
# Get these from: Supabase Dashboard → Settings → API

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# SECURITY: Never prefix this with NEXT_PUBLIC_ — it bypasses RLS.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ── App ───────────────────────────────────────────────────────
# Base URL for email redirect links (password reset, etc.)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Domain used to derive student emails from roll numbers during sync.
# e.g. roll number 25F-0510 → f250510@cfd.nu.edu.pk
STUDENT_EMAIL_DOMAIN=cfd.nu.edu.pk

# ── Emails (Resend) ───────────────────────────────────────────
RESEND_API_KEY=your-resend-api-key-here

# Verified sender. If unset, TAMS falls back to Resend's shared
# onboarding@resend.dev address, which ONLY delivers to the email
# registered to your Resend account — every message to a student is
# accepted by the API and then silently dropped. Verify a domain at
# resend.com/domains and set this before going live.
RESEND_FROM_EMAIL=TAMS <noreply@yourdomain.com>

# ── Google Sheets sync ────────────────────────────────────────
# From a Google Cloud service account with the Sheets API enabled.
# Share the target spreadsheet with the service account email as an
# Editor, otherwise the sync returns a 403.
# Keep the private key on ONE line with literal \n escapes, in quotes.
GOOGLE_SERVICE_ACCOUNT_EMAIL=tams-sync@your-project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEv...\n-----END PRIVATE KEY-----\n"
