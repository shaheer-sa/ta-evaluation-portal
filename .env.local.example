# ── Supabase ──────────────────────────────────────────────────
# Get these from: Supabase Dashboard → Settings → API

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# SECURITY: Never prefix this with NEXT_PUBLIC_ — it bypasses RLS.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ── App ───────────────────────────────────────────────────────
# Base URL for email redirect links (password reset, etc.)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Domain used to derive student emails from roll numbers during sync.
# e.g. roll number 25F-0510 → f250510@cfd.nu.edu.pk
STUDENT_EMAIL_DOMAIN=cfd.nu.edu.pk

# ── Emails (Gmail SMTP) ───────────────────────────────────────
# Gmail address used to send notification emails
GMAIL_USER=your-email@gmail.com
# Gmail app password, not the normal password
GMAIL_APP_PASSWORD=your-app-password
# Name shown as the sender in the inbox (defaults to TAMS)
GMAIL_FROM_NAME=TAMS
# Public site URL, used in email links
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Google Sheets sync ────────────────────────────────────────
# From a Google Cloud service account with the Sheets API enabled.
# Share the target spreadsheet with the service account email as an
# Editor, otherwise the sync returns a 403.
# Keep the private key on ONE line with literal \n escapes, in quotes.
GOOGLE_SERVICE_ACCOUNT_EMAIL=tams-sync@your-project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEv...\n-----END PRIVATE KEY-----\n"

# ── Rate Limiting (Upstash Redis) ─────────────────────────────
# REQUIRED in production for brute-force protection.
# Get these from: console.upstash.com (Free tier)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
